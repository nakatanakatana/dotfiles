{
  "ccgate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.gemini/antigravity-cli/ccgate-adapter.ts",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "desktop-notify": {
    "Stop": [
      {
        "type": "command",
        "command": "node ~/.gemini/antigravity-cli/notify.ts",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.gemini/antigravity-cli/notify.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
