prefix_rule(pattern=["gh", "pr", "create"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")

prefix_rule(pattern=["/bin/bash", "-lc", "GIT_EDITOR=true git rebase --continue"], decision="allow")
prefix_rule(pattern=["env", "KUBECONFIG_NAME=app.yaml", "kubectl"], decision="allow")
prefix_rule(pattern=["gh", "release", "download"], decision="allow")
prefix_rule(pattern=["gh", "release", "view"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "branch", "--show-current"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["go", "build"], decision="allow")
prefix_rule(pattern=["go", "doc"], decision="allow")
prefix_rule(pattern=["go", "list"], decision="allow")
prefix_rule(pattern=["go", "mod", "tidy"], decision="allow")
prefix_rule(pattern=["go", "test"], decision="allow")
prefix_rule(pattern=["gofmt"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "get"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "prompt"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "read"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "send-keys"], decision="allow")
prefix_rule(pattern=["herdr", "agent", "wait"], decision="allow")
prefix_rule(pattern=["herdr", "agent"], decision="allow")
prefix_rule(pattern=["herdr", "pane"], decision="allow")
prefix_rule(pattern=["make", "gen-api"], decision="allow")
prefix_rule(pattern=["make", "test-backend"], decision="allow")
prefix_rule(pattern=["nl"], decision="allow")
prefix_rule(pattern=["npm", "ci"], decision="allow")
prefix_rule(pattern=["npm", "run", "test"], decision="allow")
prefix_rule(pattern=["npm", "view"], decision="allow")
prefix_rule(pattern=["npx", "-y", "modern-web-guidance@latest"], decision="allow")
prefix_rule(pattern=["npx", "playwright", "install"], decision="allow")
prefix_rule(pattern=["true"], decision="allow")
